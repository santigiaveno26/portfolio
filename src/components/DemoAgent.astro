---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Motion from './Motion.astro';
import { COMPANY, DOCS, PRODUCTS } from '../data/demo-agent';
import { profile, type Lang } from '../data/profile';
import { casePath, demoPath, otherLang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other = otherLang(lang);

const t = {
  es: {
    title: 'Demo: agente de WhatsApp con Agentic RAG',
    sub: 'La misma arquitectura que el agente que tengo en producción, atendiendo a una empresa ficticia. Escribile como si fueras un cliente y mirá a la derecha qué decide en cada paso.',
    company: COMPANY.es,
    online: 'en línea',
    placeholder: 'Escribí un mensaje',
    tryTitle: 'Probá este recorrido',
    steps: [
      ['Pregunta comercial (abierta a todos)', '¿Qué es la PF-200 y cuánto produce?'],
      ['Pedí info técnica sin ser cliente', '¿Cada cuánto tengo que engrasar la PF-200?'],
      ['Verificá que sos dueño', 'Mi número de serie es PF-200-1001'],
      ['Repetí la pregunta técnica', '¿Cada cuánto tengo que engrasar la PF-200?'],
      ['Algo que no está en la base (2 veces)', '¿Fabrican cosechadoras?'],
      ['Pedí una cotización', 'Quiero una cotización de la BV-50'],
    ],
    inside: 'Lo que pasa por dentro',
    insideSub: 'Cada herramienta que el agente decide usar, con lo que encontró.',
    client: 'Cliente',
    notVerified: 'no verificado',
    verified: 'verificado',
    fails: 'Respuestas sin información seguidas',
    waiting: 'Mandá un mensaje para ver el razonamiento del agente.',
    noTools: 'Respondió sin usar herramientas.',
    kb: 'Base de conocimiento',
    kbSub: 'Los documentos con 🔒 solo se entregan a propietarios verificados. El bloqueo lo hace el código, no el modelo.',
    reset: 'Reiniciar',
    error: 'No pude responder. Probá de nuevo.',
    typing: 'escribiendo…',
    aiBadge: 'IA',
    offlineBadge: 'modo sin IA',
    diffTitle: 'Diferencias con el sistema en producción',
    diffs: [
      'La búsqueda es léxica (BM25) para que la demo corra gratis; en producción usa embeddings multilingües en ChromaDB.',
      'En producción también transcribe audios, analiza fotos y la derivación llega a un operador real en Chatwoot.',
      'El historial vive en tu navegador; en producción se guarda por número en la base de datos.',
    ],
    caseLink: 'Ver el caso completo',
    status: { ok: 'encontró', empty: 'sin resultados', denied: 'acceso bloqueado', handoff: 'derivado', rule: 'regla de negocio' } as Record<string, string>,
    level: { comercial: 'comercial', tecnico: 'técnico', empresa: 'empresa' } as Record<string, string>,
    you: 'Vos',
  },
  en: {
    title: 'Demo: WhatsApp agent with Agentic RAG',
    sub: "The same architecture as the agent I run in production, serving a fictional company. Message it as if you were a customer and watch on the right what it decides at each step.",
    company: COMPANY.en,
    online: 'online',
    placeholder: 'Type a message',
    tryTitle: 'Try this walkthrough',
    steps: [
      ['Sales question (open to everyone)', 'What is the PF-200 and how much can it process?'],
      ['Ask for technical info as a non-owner', 'How often should I grease the PF-200?'],
      ['Verify you own one', 'My serial number is PF-200-1001'],
      ['Ask the technical question again', 'How often should I grease the PF-200?'],
      ['Something not in the knowledge base (twice)', 'Do you build combine harvesters?'],
      ['Ask for a quote', "I'd like a quote for the BV-50"],
    ],
    inside: "What's happening inside",
    insideSub: 'Every tool the agent decides to use, and what it found.',
    client: 'Customer',
    notVerified: 'not verified',
    verified: 'verified',
    fails: 'Answers without information in a row',
    waiting: "Send a message to see the agent's reasoning.",
    noTools: 'Answered without using tools.',
    kb: 'Knowledge base',
    kbSub: 'Documents marked 🔒 are only returned to verified owners. The block is enforced in code, not by the model.',
    reset: 'Reset',
    error: "I couldn't answer. Please try again.",
    typing: 'typing…',
    aiBadge: 'AI',
    offlineBadge: 'no-AI mode',
    diffTitle: 'Differences from the production system',
    diffs: [
      'Search is lexical (BM25) so the demo runs for free; production uses multilingual embeddings in ChromaDB.',
      'Production also transcribes voice notes, analyzes photos, and hands off to a real operator in Chatwoot.',
      'History lives in your browser; in production it is stored per phone number in the database.',
    ],
    caseLink: 'Read the full case',
    status: { ok: 'found', empty: 'no results', denied: 'access blocked', handoff: 'handed off', rule: 'business rule' } as Record<string, string>,
    level: { comercial: 'sales', tecnico: 'technical', empresa: 'company' } as Record<string, string>,
    you: 'You',
  },
}[lang];

const kb = DOCS.map((d) => ({ title: d.title[lang], level: d.level, product: d.product }));
---
<Base
  lang={lang}
  title={`${t.title} · ${profile.name}`}
  description={t.sub}
  alternates={{ es: demoPath('es'), en: demoPath('en') }}
>
  <Nav lang={lang} home={false} altHref={demoPath(other)} />
  <main class="container demo" data-demo data-lang={lang} data-i18n={JSON.stringify({ status: t.status, client: t.client, notVerified: t.notVerified, verified: t.verified, waiting: t.waiting, noTools: t.noTools, error: t.error, typing: t.typing, aiBadge: t.aiBadge, offlineBadge: t.offlineBadge, you: t.you })}>
    <header class="head build-block">
      <a class="back" href={casePath(lang, 'agente-whatsapp-rag')}>← {t.caseLink}</a>
      <h1>{t.title}</h1>
      <p>{t.sub}</p>
    </header>

    <div class="layout">
      <!-- Teléfono -->
      <div class="phone build-block" role="region" aria-label="Chat">
        <div class="wa-head">
          <span class="avatar">MD</span>
          <div><strong>{t.company}</strong><small>{t.online}</small></div>
          <button type="button" class="reset" data-reset title={t.reset}>↺ {t.reset}</button>
        </div>
        <div class="wa-body" data-msgs aria-live="polite"></div>
        <form class="wa-input" data-form>
          <input name="q" maxlength="400" autocomplete="off" placeholder={t.placeholder} aria-label={t.placeholder} />
          <button type="submit" aria-label="Enviar">➤</button>
        </form>
      </div>

      <!-- Panel interno -->
      <aside class="inside build-block">
        <div class="panel">
          <h2>{t.inside}</h2>
          <p class="muted">{t.insideSub}</p>
          <div class="state">
            <span class="pill" data-owner>{t.client}: {t.notVerified}</span>
            <span class="pill" data-fails>{t.fails}: 0</span>
          </div>
          <ol class="trace" data-trace><li class="empty-trace">{t.waiting}</li></ol>
        </div>

        <div class="panel">
          <h2>{t.tryTitle}</h2>
          <ol class="steps">
            {t.steps.map(([label, msg], i) => (
              <li><button type="button" data-send={msg}><span>{i + 1}</span><em>{label}</em><q>{msg}</q></button></li>
            ))}
          </ol>
        </div>
      </aside>
    </div>

    <div class="bottom">
      <div class="panel build-block">
        <h2>{t.kb}</h2>
        <p class="muted">{t.kbSub}</p>
        <ul class="kb">
          {kb.map((d) => (
            <li class={d.level === 'tecnico' ? 'locked' : ''}>
              <span>{d.level === 'tecnico' ? '🔒' : '📄'}</span>
              <strong>{d.title}</strong>
              <small>{d.product === 'empresa' ? t.level.empresa : `${PRODUCTS[d.product][lang].split(' (')[0]} · ${t.level[d.level]}`}</small>
            </li>
          ))}
        </ul>
      </div>
      <div class="panel build-block">
        <h2>{t.diffTitle}</h2>
        <ul class="diffs">{t.diffs.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </main>
  <Motion />
</Base>

<script>
  type Step = { tool: string; args: Record<string, unknown>; status: string; detail: string; hits?: { title: string; score: number }[] };
  type Msg = { role: 'user' | 'bot'; text: string };

  const root = document.querySelector<HTMLElement>('[data-demo]')!;
  const lang = root.dataset.lang as 'es' | 'en';
  const t = JSON.parse(root.dataset.i18n!);
  const msgsEl = root.querySelector<HTMLElement>('[data-msgs]')!;
  const traceEl = root.querySelector<HTMLOListElement>('[data-trace]')!;
  const ownerEl = root.querySelector<HTMLElement>('[data-owner]')!;
  const failsEl = root.querySelector<HTMLElement>('[data-fails]')!;
  const form = root.querySelector<HTMLFormElement>('[data-form]')!;
  const input = form.querySelector('input')!;
  const KEY = `demo-agent-${lang}`;

  let state: { history: Msg[]; owner: string | null; failStreak: number } = { history: [], owner: null, failStreak: 0 };
  try { state = { ...state, ...JSON.parse(sessionStorage.getItem(KEY) || '{}') }; } catch {}
  const save = () => { try { sessionStorage.setItem(KEY, JSON.stringify(state)); } catch {} };
  let busy = false;

  const time = () => new Date().toLocaleTimeString(lang === 'es' ? 'es-AR' : 'en-US', { hour: '2-digit', minute: '2-digit' });

  function bubble(m: Msg, extra = '') {
    const div = document.createElement('div');
    div.className = `wa-msg ${m.role} ${extra}`;
    const p = document.createElement('p');
    p.textContent = m.text;
    const s = document.createElement('span');
    s.className = 'time';
    s.textContent = time() + (m.role === 'user' ? ' ✓✓' : '');
    div.append(p, s);
    msgsEl.append(div);
    msgsEl.scrollTop = msgsEl.scrollHeight;
    return div;
  }

  function renderState() {
    ownerEl.textContent = `${t.client}: ${state.owner ? `${t.verified} (${state.owner})` : t.notVerified}`;
    ownerEl.classList.toggle('ok', !!state.owner);
    failsEl.textContent = failsEl.textContent!.replace(/\d+$/, String(state.failStreak));
    failsEl.classList.toggle('warn', state.failStreak > 0);
  }

  function renderTrace(question: string, steps: Step[], source: string, escalated: boolean) {
    traceEl.querySelector('.empty-trace')?.remove();
    const li = document.createElement('li');
    li.className = 'turn';
    const head = document.createElement('div');
    head.className = 'turn-head';
    const q = document.createElement('span');
    q.textContent = `“${question}”`;
    const b = document.createElement('em');
    b.className = `src ${source}`;
    b.textContent = source === 'ai' ? t.aiBadge : t.offlineBadge;
    head.append(q, b);
    li.append(head);
    if (!steps.length) {
      const p = document.createElement('p');
      p.className = 'muted';
      p.textContent = t.noTools;
      li.append(p);
    }
    for (const s of steps) {
      const row = document.createElement('div');
      row.className = `step ${s.status}`;
      const name = document.createElement('code');
      name.textContent = s.tool + '(' + Object.entries(s.args ?? {}).map(([k, v]) => `${k}: "${String(v).slice(0, 40)}"`).join(', ') + ')';
      const st = document.createElement('span');
      st.className = 'st';
      st.textContent = `${t.status[s.status] ?? s.status} · ${s.detail}`;
      row.append(name, st);
      if (s.hits?.length) {
        const ul = document.createElement('ul');
        for (const h of s.hits) {
          const hl = document.createElement('li');
          hl.textContent = `${h.title} — score ${h.score}`;
          ul.append(hl);
        }
        row.append(ul);
      }
      li.append(row);
    }
    traceEl.prepend(li);
    if (escalated) li.classList.add('escalated');
  }

  async function send(text: string) {
    text = text.trim();
    if (!text || busy) return;
    busy = true;
    const prev = state.history.slice(-8).map((m) => ({ role: m.role === 'user' ? 'user' : 'model', text: m.text }));
    const u: Msg = { role: 'user', text };
    state.history.push(u);
    bubble(u);
    const wait = bubble({ role: 'bot', text: t.typing }, 'typing');
    try {
      const res = await fetch('/api/demo-agent', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ message: text, history: prev, lang, owner: state.owner, failStreak: state.failStreak }),
      });
      if (!res.ok) throw new Error(String(res.status));
      const d = await res.json();
      wait.remove();
      const m: Msg = { role: 'bot', text: d.reply || t.error };
      state.history.push(m);
      bubble(m, d.escalated ? 'handoff' : '');
      state.owner = d.owner ?? state.owner;
      state.failStreak = Number(d.failStreak) || 0;
      renderState();
      renderTrace(text, d.trace ?? [], d.source, !!d.escalated);
    } catch {
      wait.remove();
      bubble({ role: 'bot', text: t.error });
    } finally {
      busy = false;
      save();
    }
  }

  function restore() {
    msgsEl.replaceChildren();
    state.history.forEach((m) => bubble(m));
    renderState();
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); const v = input.value; input.value = ''; send(v); });
  root.querySelectorAll<HTMLButtonElement>('[data-send]').forEach((b) => b.addEventListener('click', () => send(b.dataset.send!)));
  root.querySelector('[data-reset]')!.addEventListener('click', () => {
    state = { history: [], owner: null, failStreak: 0 };
    save(); restore();
    traceEl.innerHTML = `<li class="empty-trace">${t.waiting}</li>`;
  });
  restore();
</script>

<style>
  .demo { padding-top: 34px; padding-bottom: 60px; }
  .head { max-width: 820px; margin-bottom: 26px; }
  .back { color: var(--muted); text-decoration: none; font-size: 0.9rem; }
  .back:hover { color: var(--accent); }
  h1 { font-size: clamp(1.7rem, 4vw, 2.5rem); line-height: 1.15; margin: 14px 0 10px; letter-spacing: -0.02em; }
  .head p { color: var(--muted); margin: 0; font-size: 1.04rem; }

  .layout { display: grid; grid-template-columns: 400px 1fr; gap: 20px; align-items: start; }

  /* ── Teléfono estilo WhatsApp ── */
  .phone { border: 1px solid var(--border); border-radius: 22px; overflow: hidden; background: #0b141a; display: flex; flex-direction: column; height: 640px; box-shadow: 0 24px 60px rgba(0,0,0,.45); position: sticky; top: 80px; }
  .wa-head { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #202c33; }
  .avatar { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: #00a884; color: #fff; font-weight: 700; font-size: 0.85rem; }
  .wa-head div { flex: 1; min-width: 0; }
  .wa-head strong { display: block; font-size: 0.92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wa-head small { color: #8696a0; font-size: 0.75rem; }
  .reset { font: 0.75rem var(--font); color: #8696a0; background: transparent; border: 1px solid #2a3942; border-radius: 8px; padding: 5px 8px; cursor: pointer; }
  .reset:hover { color: #e9edef; }
  .wa-body {
    flex: 1; overflow-y: auto; padding: 14px 12px; display: flex; flex-direction: column; gap: 6px;
    background: radial-gradient(circle at 1px 1px, rgba(255,255,255,.035) 1px, transparent 0) 0 0 / 16px 16px, #0b141a;
  }
  .wa-body :global(.wa-msg) { max-width: 85%; padding: 6px 9px 4px; border-radius: 8px; font-size: 0.88rem; line-height: 1.4; animation: msgIn .2s ease; }
  .wa-body :global(.wa-msg p) { margin: 0; white-space: pre-wrap; word-wrap: break-word; color: #e9edef; }
  .wa-body :global(.wa-msg .time) { display: block; text-align: right; font-size: 0.66rem; color: #8696a0; margin-top: 2px; }
  .wa-body :global(.wa-msg.user) { align-self: flex-end; background: #005c4b; border-top-right-radius: 2px; }
  .wa-body :global(.wa-msg.user .time) { color: #8ad1c2; }
  .wa-body :global(.wa-msg.bot) { align-self: flex-start; background: #202c33; border-top-left-radius: 2px; }
  .wa-body :global(.wa-msg.typing p) { color: #8696a0; font-style: italic; }
  .wa-body :global(.wa-msg.handoff) { border: 1px solid rgba(90,169,255,.6); }
  @keyframes msgIn { from { opacity: 0; transform: translateY(4px); } }
  .wa-input { display: flex; gap: 8px; padding: 10px; background: #202c33; }
  .wa-input input { flex: 1; min-width: 0; border: 0; border-radius: 20px; padding: 10px 14px; background: #2a3942; color: #e9edef; font: 0.9rem var(--font); }
  .wa-input input:focus { outline: 2px solid #00a884; }
  .wa-input button { width: 42px; border: 0; border-radius: 50%; background: #00a884; color: #fff; cursor: pointer; }

  /* ── Panel interno ── */
  .inside { display: flex; flex-direction: column; gap: 16px; }
  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
  .panel h2 { margin: 0 0 4px; font-size: 1.05rem; }
  .muted { color: var(--muted); font-size: 0.86rem; margin: 0 0 12px; }
  .state { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .pill { font-family: var(--mono); font-size: 0.75rem; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface-2); color: var(--muted); transition: all .3s; }
  .pill.ok { color: var(--accent); border-color: rgba(62,224,168,.5); background: var(--accent-soft); }
  .pill.warn { color: var(--warn); border-color: rgba(255,181,71,.5); }

  .trace { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; max-height: 340px; overflow-y: auto; }
  .trace :global(.empty-trace) { color: var(--muted); font-size: 0.88rem; padding: 18px; border: 1px dashed var(--border); border-radius: 10px; text-align: center; }
  .trace :global(.turn) { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; background: #0f151c; animation: msgIn .25s ease; }
  .trace :global(.turn.escalated) { border-color: rgba(90,169,255,.5); }
  .trace :global(.turn-head) { display: flex; justify-content: space-between; gap: 10px; font-size: 0.82rem; color: var(--text); margin-bottom: 6px; }
  .trace :global(.src) { font-style: normal; font-family: var(--mono); font-size: 0.68rem; padding: 1px 7px; border-radius: 999px; white-space: nowrap; align-self: flex-start; }
  .trace :global(.src.ai) { color: var(--accent); background: var(--accent-soft); }
  .trace :global(.src.offline) { color: var(--warn); background: rgba(255,181,71,.1); }
  .trace :global(.step) { border-left: 3px solid var(--border); padding: 4px 0 4px 10px; margin-top: 6px; }
  .trace :global(.step code) { display: block; font-family: var(--mono); font-size: 0.74rem; color: var(--accent-2); word-break: break-word; }
  .trace :global(.step .st) { display: block; font-size: 0.78rem; margin-top: 2px; }
  .trace :global(.step ul) { margin: 4px 0 0; padding-left: 16px; font-size: 0.75rem; color: var(--muted); }
  .trace :global(.step.ok) { border-color: var(--accent); }
  .trace :global(.step.ok .st) { color: var(--accent); }
  .trace :global(.step.denied) { border-color: #ff6b6b; }
  .trace :global(.step.denied .st) { color: #ff8a8a; }
  .trace :global(.step.empty) { border-color: var(--warn); }
  .trace :global(.step.empty .st) { color: var(--warn); }
  .trace :global(.step.handoff), .trace :global(.step.rule) { border-color: var(--accent-2); }
  .trace :global(.step.handoff .st), .trace :global(.step.rule .st) { color: var(--accent-2); }

  .steps { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .steps button { width: 100%; height: 100%; text-align: left; cursor: pointer; font: inherit; color: var(--text); background: #0f151c; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; display: grid; grid-template-columns: 22px 1fr; gap: 2px 8px; transition: border-color .2s; }
  .steps button:hover { border-color: var(--accent); }
  .steps span { grid-row: span 2; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px; background: var(--accent-soft); color: var(--accent); font-family: var(--mono); font-size: 0.75rem; }
  .steps em { font-style: normal; font-size: 0.8rem; color: var(--muted); }
  .steps q { font-size: 0.82rem; }

  .bottom { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; margin-top: 20px; }
  .kb { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .kb li { display: grid; grid-template-columns: 20px 1fr; gap: 0 6px; font-size: 0.82rem; padding: 6px 8px; border-radius: 8px; background: #0f151c; }
  .kb li span { grid-row: span 2; }
  .kb li small { color: var(--muted); font-size: 0.72rem; }
  .kb li.locked strong { color: #ffb4b4; }
  .diffs { margin: 6px 0 0; padding-left: 18px; color: var(--muted); font-size: 0.88rem; }
  .diffs li { margin-bottom: 8px; }

  @media (max-width: 980px) {
    .layout, .bottom { grid-template-columns: 1fr; }
    .phone { position: static; height: 560px; }
  }
  @media (max-width: 560px) {
    .steps, .kb { grid-template-columns: 1fr; }
  }
</style>
