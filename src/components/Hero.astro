---
import { profile, stats, type Lang } from '../data/profile';
import { ui } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const words = profile.rotating[lang];
---
<section id="top" class="hero">
  <canvas class="net" aria-hidden="true" data-net></canvas>
  <div class="container">
    <div class="hero-grid">
      <div class="build-block">
        {profile.available && <span class="badge"><i></i> {t.available}</span>}
        <h1>
          {t.hello} <span class="hl">{profile.name.split(' ')[0]}</span>.<br />
          <span class="role">{profile.role[lang]}</span>
        </h1>
        <p class="rotator" aria-label={`${t.iBuild} ${words.join(', ')}`}>
          <span class="mono">&gt;</span> {t.iBuild}
          <span class="word" data-words={JSON.stringify(words)} aria-hidden="true">{words[0]}</span><span class="caret" aria-hidden="true"></span>
        </p>
        <p class="tagline">{profile.tagline[lang]}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#proyectos">{t.seeProjects}</a>
          <a class="btn" href="#busco">{t.openToBtn}</a>
          <a class="btn" href={profile.cvs[lang]} download>{t.downloadCv}</a>
        </div>
        <p class="loc">📍 {profile.location[lang]}</p>
      </div>

      <aside class="card-term build-block tilt" aria-hidden="true">
        <div class="ct-bar"><span></span><span></span><span></span><em>whoami.py</em></div>
        {lang === 'es' ? (
          <pre><code><span class="c-k">santiago</span> = {'{'}
  <span class="c-s">"rol"</span>: <span class="c-v">"IA aplicada a empresas"</span>,
  <span class="c-s">"foco"</span>: [<span class="c-v">"agentes + RAG"</span>, <span class="c-v">"modelos predictivos"</span>,
           <span class="c-v">"automatización"</span>],
  <span class="c-s">"en_produccion"</span>: <span class="c-n">True</span>,
  <span class="c-s">"formacion"</span>: <span class="c-v">"Téc. en IA · UNR"</span>,
{'}'}</code></pre>
        ) : (
          <pre><code><span class="c-k">santiago</span> = {'{'}
  <span class="c-s">"role"</span>: <span class="c-v">"applied AI for business"</span>,
  <span class="c-s">"focus"</span>: [<span class="c-v">"agents + RAG"</span>, <span class="c-v">"predictive models"</span>,
            <span class="c-v">"automation"</span>],
  <span class="c-s">"in_production"</span>: <span class="c-n">True</span>,
  <span class="c-s">"degree"</span>: <span class="c-v">"AI Technician · UNR"</span>,
{'}'}</code></pre>
        )}
      </aside>
    </div>

    <ul class="stats">
      {stats.map((s) => (
        <li class="build-block">
          <strong>
            {s.prefix}<span data-count={s.value}>{s.value}</span>{s.suffix}
          </strong>
          <span>{s.label[lang]}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // ── Fondo: red neuronal sutil (nodos que derivan y se conectan) ──
  const canvas = document.querySelector<HTMLCanvasElement>('[data-net]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduced) {
    const ctx = canvas.getContext('2d')!;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    let w = 0, h = 0, raf = 0, visible = true;
    let nodes: { x: number; y: number; vx: number; vy: number }[] = [];
    const mouse = { x: -9999, y: -9999 };

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(70, (w * h) / 16000));
      nodes = Array.from({ length: n }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.25, vy: (Math.random() - 0.5) * 0.25,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const max = 130;
      for (const p of nodes) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
      }
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < max) {
            ctx.strokeStyle = `rgba(62,224,168,${0.12 * (1 - d / max)})`;
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
        const dm = Math.hypot(a.x - mouse.x, a.y - mouse.y);
        const near = dm < 160;
        if (near) {
          ctx.strokeStyle = `rgba(90,169,255,${0.25 * (1 - dm / 160)})`;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
        }
        ctx.fillStyle = near ? 'rgba(90,169,255,.8)' : 'rgba(62,224,168,.45)';
        ctx.beginPath(); ctx.arc(a.x, a.y, near ? 2.2 : 1.6, 0, Math.PI * 2); ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    };

    const start = () => { if (!raf && visible && !document.hidden) raf = requestAnimationFrame(draw); };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; };

    resize();
    addEventListener('resize', () => { resize(); });
    canvas.parentElement!.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    });
    canvas.parentElement!.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }

  // ── "Construyo ___": palabras que se escriben y borran ──
  const el = document.querySelector<HTMLElement>('[data-words]');
  if (el && !reduced) {
    const words = JSON.parse(el.dataset.words!) as string[];
    let wi = 0, ci = words[0].length, deleting = true;
    const tick = () => {
      const word = words[wi];
      if (deleting) {
        ci--;
        if (ci <= 0) { deleting = false; wi = (wi + 1) % words.length; }
      } else {
        ci++;
        if (ci >= words[wi].length) { deleting = true; el.textContent = words[wi]; return setTimeout(tick, 2200); }
      }
      el.textContent = (deleting ? word : words[wi]).slice(0, Math.max(ci, 0));
      setTimeout(tick, deleting ? 40 : 75);
    };
    setTimeout(tick, 2600);
  }
</script>

<style>
  .hero { padding: 90px 0 70px; position: relative; overflow: hidden; }
  .net { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 30%, transparent 100%); }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(600px 300px at 15% 10%, rgba(62,224,168,.10), transparent 70%),
      radial-gradient(500px 300px at 90% 30%, rgba(90,169,255,.08), transparent 70%);
  }
  .hero > .container { position: relative; z-index: 1; }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 48px; align-items: center; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--accent);
    padding: 6px 12px; border-radius: 999px; background: var(--accent-soft); border: 1px solid rgba(62,224,168,.25);
  }
  .badge i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); animation: breathe 2.4s ease-in-out infinite; }
  @keyframes breathe { 50% { box-shadow: 0 0 2px var(--accent); opacity: .7; } }
  h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.08; margin: 20px 0 14px; letter-spacing: -0.02em; }
  .hl {
    background: linear-gradient(90deg, var(--accent), var(--accent-2), var(--accent));
    background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: sheen 6s linear infinite;
  }
  @keyframes sheen { to { background-position: 200% center; } }
  .rotator { font-family: var(--mono); font-size: 1.05rem; color: var(--muted); margin: 0 0 16px; min-height: 1.6em; }
  .rotator .mono { color: var(--accent); }
  .word { color: var(--text); }
  .caret { display: inline-block; width: 9px; height: 1.1em; background: var(--accent); margin-left: 3px; vertical-align: -3px; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .tagline { color: var(--muted); font-size: 1.08rem; max-width: 560px; margin: 0 0 28px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .loc { color: var(--muted); font-size: 0.9rem; margin: 22px 0 0; }

  .card-term { background: #0a0e13; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,.35); }
  .ct-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--border); background: #111821; }
  .ct-bar span { width: 9px; height: 9px; border-radius: 50%; background: #2a3746; }
  .ct-bar em { font-style: normal; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); margin-left: 6px; }
  pre { margin: 0; padding: 18px; font-family: var(--mono); font-size: 0.84rem; line-height: 1.7; overflow-x: auto; }
  .c-k { color: var(--accent-2); } .c-s { color: #f0a6ff; } .c-v { color: var(--accent); } .c-n { color: var(--warn); }

  .stats { list-style: none; padding: 0; margin: 64px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .stats li { background: rgba(20,28,38,.85); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; display: flex; flex-direction: column; gap: 4px; }
  .stats strong { font-size: 1.6rem; color: var(--text); font-variant-numeric: tabular-nums; }
  .stats span { color: var(--muted); font-size: 0.85rem; line-height: 1.4; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
