---
import { projects, kindLabel, type Lang } from '../data/profile';
import { ui, caseUi, casePath, demoPath } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].projects;
const c = caseUi[lang];
const groups = [projects.filter((p) => p.featured), projects.filter((p) => !p.featured)];
---
<section id="proyectos">
  <div class="container">
    <div class="build-block">
      <p class="section-label">{t.label}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-sub">{t.sub}</p>
    </div>

    {groups.map((list, gi) => (
      <div class={`grid ${gi === 1 ? 'second' : ''}`}>
        {list.map((p) => (
          <article class="card spot build-block">
            <header>
              <span class={`kind kind-${p.kind}`}>{kindLabel[p.kind][lang]}</span>
              {p.status && <span class="status"><i></i>{p.status[lang]}</span>}
            </header>
            <h3>{p.title[lang]}</h3>
            <p class="client">{p.client[lang]}</p>
            <p class="summary">{p.summary[lang]}</p>
            {gi === 0 && <ul class="hl">{p.highlights[lang].map((h) => <li>{h}</li>)}</ul>}
            <div class="stack">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
            <div class="links">
              <a class="more" href={casePath(lang, p.slug)}>{c.seeCase} →</a>
              {p.demo && <a class="demo" href={demoPath(lang)}><i></i>{c.tryDemo}</a>}
            </div>
          </article>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .grid { display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr); }
  .grid.second { margin-top: 18px; }
  .card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 22px; display: flex; flex-direction: column;
    transition: border-color .25s, transform .25s, box-shadow .25s;
  }
  .card:hover { border-color: rgba(62,224,168,.45); transform: translateY(-3px); box-shadow: 0 14px 34px rgba(0,0,0,.35); }
  header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 14px; }
  .kind { font-family: var(--mono); font-size: 0.72rem; padding: 3px 8px; border-radius: 6px; background: var(--surface-2); color: var(--muted); }
  .kind-client { color: var(--accent); background: var(--accent-soft); }
  .kind-internship { color: var(--accent-2); background: rgba(90,169,255,.12); }
  .status { display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; color: var(--muted); }
  .status i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 6px var(--accent); }
  h3 { margin: 0 0 4px; font-size: 1.12rem; line-height: 1.3; }
  .client { margin: 0 0 12px; color: var(--muted); font-size: 0.85rem; }
  .summary { margin: 0 0 14px; font-size: 0.93rem; }
  .hl { margin: 0 0 16px; padding-left: 18px; color: var(--muted); font-size: 0.86rem; }
  .hl li { margin-bottom: 5px; }
  .hl li::marker { color: var(--accent); }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
  .links { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border); }
  .more { color: var(--accent); text-decoration: none; font-size: 0.88rem; font-weight: 600; }
  .more:hover { text-decoration: underline; }
  .demo {
    display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
    font-size: 0.78rem; font-weight: 600; color: #04120c; background: var(--accent);
    padding: 4px 10px; border-radius: 999px;
  }
  .demo i { width: 6px; height: 6px; border-radius: 50%; background: #04120c; animation: live 1.4s ease-in-out infinite; }
  @keyframes live { 50% { opacity: .3; } }
  /* La tarjeta entera lleva al caso (el link de demo queda por encima) */
  .card { position: relative; }
  .more::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .demo { position: relative; z-index: 1; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
