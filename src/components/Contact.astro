---
import { profile, type Lang } from '../data/profile';
import { ui, pdfPath } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const { contact, cvs } = profile;
const wa = contact.whatsapp ? `${contact.whatsapp}?text=${encodeURIComponent(t.contact.waText)}` : null;
const year = new Date().getFullYear();
---
<section id="contacto">
  <div class="container">
    <div class="cta build-block">
      <p class="section-label">{t.contact.label}</p>
      <h2 class="section-title">{t.contact.title}</h2>
      <p class="section-sub">{t.contact.sub}</p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${contact.email}?subject=${encodeURIComponent(t.contact.emailSubject)}`}>{contact.email}</a>
        <a class="btn" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        {wa && <a class="btn" href={wa} target="_blank" rel="noopener">{t.contact.whatsapp}</a>}
      </div>
      <div class="links">
        <a href={contact.github} target="_blank" rel="noopener">GitHub</a>
        <a href={cvs[lang]} download>{t.downloadCv} ↓</a>
        <a href={cvs[lang === 'es' ? 'en' : 'es']} download>{t.cvOther} ↓</a>
        <a href={pdfPath(lang)} download>{lang === 'es' ? 'Portfolio completo en PDF' : 'Full portfolio as PDF'} ↓</a>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container foot-inner">
    <span>© {year} {profile.name}</span>
    <span>{t.footer.made} · <a href="#intro" data-replay>{t.footer.replay}</a></span>
  </div>
</footer>

<script>
  document.querySelector('[data-replay]')?.addEventListener('click', (e) => {
    e.preventDefault();
    location.hash = 'intro';
    location.reload();
  });
</script>

<style>
  .cta {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, rgba(62,224,168,.08), rgba(90,169,255,.06));
    border: 1px solid var(--border); border-radius: 20px; padding: 48px;
  }
  /* Borde con brillo que recorre la tarjeta */
  .cta::after {
    content: ''; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; pointer-events: none;
    background: conic-gradient(from var(--a, 0deg), transparent 0 80%, var(--accent) 90%, transparent 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    animation: spin 6s linear infinite; opacity: .7;
  }
  @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes spin { to { --a: 360deg; } }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .links { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 26px; }
  .links a { color: var(--muted); text-decoration: none; font-size: 0.92rem; }
  .links a:hover { color: var(--accent); }
  .footer { border-top: 1px solid var(--border); padding: 26px 0 90px; color: var(--muted); font-size: 0.85rem; }
  .foot-inner { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
  .footer a { color: var(--muted); }
  .footer a:hover { color: var(--accent); }
  @media (max-width: 640px) { .cta { padding: 28px 22px; } }
  @media (prefers-reduced-motion: reduce) { .cta::after { animation: none; opacity: 0; } }
</style>
