---
// Layout para generar los PDF (fondo blanco, A4). No se enlaza desde el sitio: solo se usa para imprimir.
interface Props { lang: 'es' | 'en'; title: string }
const { lang, title } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body><slot /></body>
</html>

<style is:global>
  @page { size: A4; margin: 10mm 12mm 10mm; }
  :root { --ink: #111; --muted: #57606a; --line: #d0d7de; --accent: #0b7a55; --accent-bg: #e9fbf4; --blue: #0a58ca; --font: 'Inter', Arial, sans-serif; --mono: 'JetBrains Mono', Consolas, monospace; }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: #fff; color: var(--ink); font-family: var(--font); font-size: 9pt; line-height: 1.4; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  a { color: var(--blue); text-decoration: none; }
  .page { break-after: page; }
  .page:last-child { break-after: auto; }
  h1, h2, h3 { margin: 0; line-height: 1.2; }
  .chip { display: inline-block; font-family: var(--mono); font-size: 7.4pt; padding: 1px 6px; border-radius: 99px; border: 1px solid var(--line); color: #333; margin: 0 3px 3px 0; }
</style>
